        },
        {
          "id": 3,
          "question": "What is returned by Array.prototype.map()?",
          "options": [
            "The original array modified in-place",
            "A newly transformed array of identical length",
            "A filtered subset of elements",
            "A boolean flag indicating array mutation"
          ],
          "correctIndex": 1,
          "explanation": "'map()' creates a brand new array containing results of calling the provided function on every element."
        },
